{
  "name": "oura-mcp",
  "version": "1.3.0",
  "description": "MCP server for Oura Ring API integration",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "oura-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "format": "prettier -w \"src/**/*.{ts,js,json,md}\" || true",
    "lint": "echo 'No linter configured yet'",
    "prepack": "pnpm run build",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "oura",
    "mcp",
    "health",
    "sleep",
    "fitness"
  ],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "packageManager": "pnpm@10.16.0",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "dotenv": "^17.4.2",
    "zod": "^4.4.3",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/node": "^25.9.5",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  }
}
